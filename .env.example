# =====================================================================
# ローカル開発環境（Docker Compose）の設定
# `cp .env.example .env` でコピーして使う。.env はコミットしない（憲章 8.6）
# =====================================================================

COMPOSE_PROJECT_NAME=joushou
TZ=Asia/Tokyo

# --- MySQL -----------------------------------------------------------
MYSQL_DATABASE=joushou
MYSQL_USER=joushou
# 必須。任意の値を設定する
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Next.js ---------------------------------------------------------
# Laravel の API の実装前は Apidog のモックの URL を指定する（architecture.md 9.4）
# 未指定の場合は Caddy 経由で Laravel を呼ぶ（http://caddy:8080）
API_BASE_URL=

# --- ホスト側のポート（ほかのプロジェクトと重なる場合に変更する） --
# MYSQL_PORT=3306
# API_PORT=8080
# MAILPIT_UI_PORT=8025

# --- バージョン（通常は変更しない） ---------------------------------
# NODE_VERSION=24
# BUN_VERSION=1
# PHP_VERSION=8.5
# MYSQL_VERSION=8.4
